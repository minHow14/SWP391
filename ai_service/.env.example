# D:/SWP391/SWP391/ai_service/.env.example
# Same key as BE: 32-256 printable ASCII characters, no whitespace; no automatic trimming.
INTERNAL_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro
DEBUG=False
ALLOWED_ORIGINS=http://localhost:5000
TRUSTED_PROXIES=127.0.0.1,::1
RATE_LIMIT=30/minute

# Vietnamese YouTube recipe extraction; keep provider keys server-side.
GROQ_API_KEY=
VIDEO_FFMPEG_PATH=
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=120
VIDEO_DECODE_TIMEOUT_SECONDS=60
VIDEO_GROQ_TIMEOUT_SECONDS=180
VIDEO_SUMMARY_TIMEOUT_SECONDS=120
VIDEO_MAX_DOWNLOAD_BYTES=52428800
