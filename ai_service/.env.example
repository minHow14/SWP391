# Sao chép thành .env rồi điền giá trị thật. Không commit file .env.

# --- AI ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Gemini phụ trách thực đơn (JSON). Để trống thì thực đơn cũng dùng DeepSeek.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Database (PostgreSQL của nhóm). Có DATABASE_URL thì bỏ qua các biến DB_* ---
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vegetarian_db
DB_NAME=vegetarian_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Bảo mật ---
DEBUG=false
# JWT do backend Core ký (HS256, claims: sub = user id, role). Trống JWT_SECRET thì dùng SECRET_KEY.
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=
JWT_ALGORITHM=HS256
# true: nhận danh tính qua header X-User-Id (chỉ để phát triển). Khi demo/deploy đặt false.
AUTH_DEV_MODE=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Hạn mức ---
# Khách: tổng số câu hỏi chatbot + lần tạo thực đơn mỗi ngày (giờ Việt Nam +07:00)
GUEST_DAILY_LIMIT=3
# Giới hạn tần suất theo IP (cú pháp slowapi)
RATE_LIMIT=30/minute
