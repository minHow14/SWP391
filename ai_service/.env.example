# D:/SWP391/SWP391/ai_service/.env.example
# Same key as BE: 32-256 printable ASCII characters, no whitespace; no automatic trimming.
INTERNAL_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-pro
# Seconds for each text or image moderation call; keep below the worker's CONTENT_MODERATION_TIMEOUT_MS / 1000.
CONTENT_MODERATION_TIMEOUT_SECONDS=20
DEBUG=False
ALLOWED_ORIGINS=http://localhost:5000
TRUSTED_PROXIES=127.0.0.1,::1
RATE_LIMIT=30/minute

# Native Vietnamese YouTube captions only; no audio/STT provider or translation.
# Caption HTTP responses are bounded to 4 MiB; socket reads wait at most 5 seconds.
VIDEO_CAPTIONS_TIMEOUT_SECONDS=30
VIDEO_SUMMARY_TIMEOUT_SECONDS=120
