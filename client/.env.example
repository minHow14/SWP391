# Cấu hình môi trường cho Frontend React SPA
# Mặc định trong dev mode, Vite proxy các request /api sang http://127.0.0.1:5000
# Nếu cần ghi đè URL Backend API khi build hoặc deploy production:
VITE_API_URL=http://localhost:5000/api

# Dịch vụ AI (chatbot, thực đơn, quản trị AI). Mặc định dev: /ai-api (Vite proxy sang http://127.0.0.1:8000).
# Khi deploy, đặt URL gốc của dịch vụ AI, ví dụ: https://ai.example.com/api
# VITE_AI_API_URL=/ai-api
