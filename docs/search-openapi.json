{
  "openapi": "3.1.0",
  "info": {
    "title": "ChayXanh Video & Blog Search API",
    "version": "1.0.0",
    "description": "Public search API for Videos and Blogs across the ChayXanh community platform, available to all users (guest and authenticated)."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Express backend"
    }
  ],
  "paths": {
    "/api/v1/search": {
      "get": {
        "summary": "Global search for Videos and Blogs",
        "description": "Search published blogs and videos by keyword in title, content, or transcript. Supports type filtering and pagination. Accessible to all users without authentication.",
        "operationId": "globalSearch",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search keyword query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Filter content type",
            "schema": {
              "type": "string",
              "enum": ["ALL", "BLOG", "VIDEO"],
              "default": "ALL"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-indexed)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of items per content type",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "required": false,
            "description": "Filter by category ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Thành công" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "query": { "type": "string", "example": "nấm" },
                        "type": { "type": "string", "example": "ALL" },
                        "results": {
                          "type": "object",
                          "properties": {
                            "blogs": { "type": "array", "items": { "type": "object" } },
                            "videos": { "type": "array", "items": { "type": "object" } }
                          }
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "page": { "type": "integer", "example": 1 },
                        "limit": { "type": "integer", "example": 20 },
                        "total": { "type": "integer", "example": 15 },
                        "totalPages": { "type": "integer", "example": 1 },
                        "totalBlogs": { "type": "integer", "example": 10 },
                        "totalVideos": { "type": "integer", "example": 5 }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters (e.g. missing query `q`)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": false },
                    "message": { "type": "string" },
                    "errorCode": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
