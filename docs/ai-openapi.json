{
  "openapi": "3.1.0",
  "info": {
    "title": "Chay Xanh AI Gateway",
    "version": "1.0.0",
    "description": "BE owns authentication, quota and persistence. Keep SSE per approved project exception. History stores validated request and complete AI result for authenticated members only."
  },
  "servers": [
    {
      "url": "http://localhost:5000"
    }
  ],
  "paths": {
    "/api/ai/usage": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          }
        }
      }
    },
    "/api/ai/chat/stream": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE token/progress and done/error. done.meta.generationId is set for members after persistence.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "422": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "429": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "502": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "503": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "504": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          }
        }
      }
    },
    "/api/ai/meal-planner/generate/stream": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MealPlanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE token/progress and done/error. done.meta.generationId is set for members after persistence.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "422": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "429": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "502": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "503": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "504": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          }
        }
      }
    },
    "/api/v1/ai-generations": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Own records only; data is an array, meta has page, limit, total, totalPages. System prompts are omitted."
          },
          "401": {
            "description": "Own records only; data is an array, meta has page, limit, total, totalPages. System prompts are omitted."
          },
          "404": {
            "description": "Own records only; data is an array, meta has page, limit, total, totalPages. System prompts are omitted."
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "CHAT",
                "MEAL_PLAN"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PROCESSING",
                "COMPLETED",
                "FAILED"
              ]
            }
          }
        ]
      }
    },
    "/api/v1/ai-generations/{id}": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "401": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "404": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/ai/food-scanner/analyze": {
      "post": {
        "summary": "Phân tích hình ảnh món ăn hoặc bao bì nhãn thành phần",
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FoodScanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kết quả thẩm định 5 lớp ẩm thực chay, nguyên liệu an toàn và checklist câu hỏi.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodScanResponse"
                }
              }
            }
          },
          "401": {
            "description": "Lỗi xác thực người dùng."
          },
          "422": {
            "description": "Dữ liệu ảnh base64 hoặc tham số không hợp lệ."
          },
          "429": {
            "description": "Hết hạn ngạch câu hỏi trong ngày của khách."
          },
          "502": {
            "description": "Lỗi từ AI Microservice hoặc nhà cung cấp LLM."
          },
          "503": {
            "description": "Dịch vụ AI chưa được cấu hình."
          },
          "504": {
            "description": "Quá thời gian xử lý hình ảnh."
          }
        }
      }
    },
    "/api/v1/video-recipe-summary-jobs": {
      "post": {
        "summary": "Tạo job bóc tách công thức nấu ăn từ video YouTube",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "youtubeUrl"
                ],
                "properties": {
                  "youtubeUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "Đường dẫn YouTube video"
                  },
                  "dietTypeId": {
                    "type": "integer",
                    "description": "ID chế độ ăn chay áp dụng"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Khởi tạo job bóc tách video thành công"
          },
          "400": {
            "description": "Đường dẫn video không hợp lệ"
          },
          "401": {
            "description": "Yêu cầu đăng nhập thành viên"
          },
          "409": {
            "description": "Đang có một job bóc tách video khác đang chạy"
          }
        }
      },
      "get": {
        "summary": "Lấy danh sách các jobs bóc tách video của tài khoản",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách jobs kèm trạng thái xử lý"
          }
        }
      }
    },
    "/api/v1/video-recipe-summary-jobs/{jobId}": {
      "get": {
        "summary": "Lấy tiến độ và trạng thái chi tiết của một job",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chi tiết job (PENDING, PROCESSING, COMPLETED, FAILED)"
          },
          "404": {
            "description": "Không tìm thấy job"
          }
        }
      }
    },
    "/api/v1/video-recipe-summaries/{summaryId}": {
      "get": {
        "summary": "Lấy kết quả tóm tắt công thức đã bóc tách từ video",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "summaryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dữ liệu công thức: nguyên liệu, các bước nấu, lưu ý dinh dưỡng"
          },
          "404": {
            "description": "Không tìm thấy kết quả tóm tắt"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ChatRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "history": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                }
              },
              "required": [
                "role",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "dietaryType": {
            "type": "string",
            "enum": [
              "vegan",
              "lacto",
              "ovo",
              "lacto_ovo"
            ]
          },
          "menuContext": {
            "type": "string",
            "maxLength": 8000
          }
        },
        "required": [
          "message",
          "history"
        ],
        "additionalProperties": false
      },
      "MealPlanRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "heightCm": {
            "type": "number",
            "exclusiveMinimum": 50,
            "exclusiveMaximum": 260
          },
          "weightKg": {
            "type": "number",
            "exclusiveMinimum": 20,
            "exclusiveMaximum": 300
          },
          "bmi": {
            "type": "number",
            "exclusiveMinimum": 8,
            "exclusiveMaximum": 100
          },
          "age": {
            "type": "integer",
            "minimum": 10,
            "maximum": 120
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "other",
              "unspecified"
            ]
          },
          "goal": {
            "type": "string",
            "enum": [
              "weight_loss",
              "muscle_gain",
              "maintenance"
            ]
          },
          "activityLevel": {
            "type": "string",
            "enum": [
              "sedentary",
              "light",
              "moderate",
              "active",
              "very_active"
            ]
          },
          "dietaryType": {
            "type": "string",
            "enum": [
              "vegan",
              "lacto",
              "ovo",
              "lacto_ovo"
            ]
          },
          "allergies": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "availableIngredients": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "required": [
          "heightCm",
          "weightKg"
        ],
        "additionalProperties": false
      },
      "FoodScanRequest": {
        "type": "object",
        "properties": {
          "imageBase64": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15728640,
            "description": "Chuỗi Base64 của ảnh món ăn hoặc bao bì"
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ],
            "default": "image/jpeg"
          },
          "dietTypeId": {
            "type": "integer",
            "minimum": 1,
            "description": "ID chế độ ăn chay"
          },
          "scanType": {
            "type": "string",
            "enum": [
              "AUTO",
              "LABEL",
              "DISH"
            ],
            "default": "AUTO"
          },
          "dishName": {
            "type": "string",
            "maxLength": 150,
            "default": ""
          },
          "allergies": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "maxItems": 50,
            "default": []
          }
        },
        "required": [
          "imageBase64",
          "dietTypeId"
        ],
        "additionalProperties": false
      },
      "FoodScanResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "dishName": {
                "type": "string"
              },
              "detectedScanType": {
                "type": "string",
                "enum": [
                  "LABEL",
                  "DISH"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "clear",
                  "warning",
                  "inconclusive"
                ]
              },
              "summary": {
                "type": "string"
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ingredient": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "layer": {
                      "type": "integer"
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "violation",
                        "warning",
                        "info"
                      ]
                    }
                  }
                }
              },
              "identifiedIngredients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "restaurantChecklist": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "swapSuggestions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "nutritionEstimate": {
                "type": "object",
                "properties": {
                  "calories": {
                    "type": "number"
                  },
                  "protein": {
                    "type": "number"
                  },
                  "carbs": {
                    "type": "number"
                  },
                  "fat": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "generationId": {
                "type": "string",
                "nullable": true
              },
              "remaining": {
                "type": "integer",
                "nullable": true
              }
            }
          }
        }
      }
    }
  }
}