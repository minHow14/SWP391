          }
        },
        "responses": {
          "200": {
            "description": "SSE token/progress and done/error. done.meta.generationId is set for members after persistence.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "422": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "429": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "502": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "503": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          },
          "504": {
            "description": "Standard success/error envelope; streamed endpoints terminate with done or error."
          }
        }
      }
    },
    "/api/v1/ai-generations": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Own records only; paginated data array. Types CHAT, MEAL_PLAN, FOOD_SCAN. System prompts omitted; imageBase64 omitted from list requestPayload, retained by owned detail endpoint."
          },
          "401": {
            "description": "Authentication required."
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "CHAT",
                "MEAL_PLAN",
                "FOOD_SCAN"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PROCESSING",
                "COMPLETED",
                "FAILED"
              ]
            }
          }
        ]
      }
    },
    "/api/v1/ai-generations/{id}": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Owned record including validated requestPayload, responsePayload, status, safe error and timestamps. System prompts omitted."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Record absent or owned by another member."
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/ai/food-scanner/analyze": {
      "post": {
        "summary": "Phân tích hình ảnh món ăn hoặc bao bì nhãn thành phần",
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FoodScanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kết quả thẩm định 5 lớp ẩm thực chay, nguyên liệu an toàn và checklist câu hỏi.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodScanResponse"
                }
              }
            }
          },
          "401": {
            "description": "Lỗi xác thực người dùng."
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE: scanner JSON parser bound exceeded."
          },
          "422": {
            "description": "Dữ liệu ảnh base64 hoặc tham số không hợp lệ."
          },
          "429": {
            "description": "Hết hạn ngạch câu hỏi trong ngày của khách."
          },
          "502": {
            "description": "AI_PROVIDER_ERROR when AI service/provider fails, or AI_INVALID_OUTPUT for malformed success payload; no successful scan persisted."
          },
          "503": {
            "description": "AI_NOT_CONFIGURED or AI_INTERNAL_AUTH_FAILED; never fabricated analysis."
          },
          "504": {
            "description": "Quá thời gian xử lý hình ảnh."
          }
        },
        "description": "Decoded image <=10 MiB; bounded JSON payload <=14046552 bytes including base64 overhead. Other API routes retain 1 MiB. Real model analysis only; errors never fabricate success. AI service also validates MIME/container signature. Default gateway budget180s; scanner client waits190s."
      }
    },
    "/api/v1/ai/food-scanner/analyze": {
      "post": {
        "summary": "Phân tích hình ảnh món ăn hoặc bao bì nhãn thành phần",
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FoodScanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kết quả thẩm định 5 lớp ẩm thực chay, nguyên liệu an toàn và checklist câu hỏi.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodScanResponse"
                }
              }
            }
          },
          "401": {
            "description": "Lỗi xác thực người dùng."
          },
          "413": {
            "description": "PAYLOAD_TOO_LARGE: scanner JSON parser bound exceeded."
          },
          "422": {
            "description": "Dữ liệu ảnh base64 hoặc tham số không hợp lệ."
          },
          "429": {
            "description": "Hết hạn ngạch câu hỏi trong ngày của khách."
          },
          "502": {
            "description": "AI_PROVIDER_ERROR when AI service/provider fails, or AI_INVALID_OUTPUT for malformed success payload; no successful scan persisted."
          },
          "503": {
            "description": "AI_NOT_CONFIGURED or AI_INTERNAL_AUTH_FAILED; never fabricated analysis."
          },
          "504": {
            "description": "Quá thời gian xử lý hình ảnh."
          }
        },
        "description": "Decoded image <=10 MiB; bounded JSON payload <=14046552 bytes including base64 overhead. Other API routes retain 1 MiB. Real model analysis only; errors never fabricate success. AI service also validates MIME/container signature. Default gateway budget180s; scanner client waits190s."
      }
    },
    "/api/v1/video-recipe-summary-jobs": {
      "post": {
        "summary": "Create or reuse owned YouTube recipe job",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Vietnamese cooking video <=660 seconds; one active job per member. Worker starts with API. No provider work in the HTTP request.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "videoUrl"
                ],
                "additionalProperties": false,
                "properties": {
                  "videoUrl": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing completed job.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/VideoRecipeJob"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Job accepted or already pending/processing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/VideoRecipeJob"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or unsupported URL."
          },
          "401": {
            "description": "Authentication required."
          },
          "409": {
            "description": "VIDEO_JOB_ALREADY_ACTIVE or VIDEO_JOB_FAILED; use retries for a failed job."
          }
        }
      },
      "get": {
        "summary": "List owned video jobs",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "PROCESSING",
                "COMPLETED",
                "FAILED"
              ]
            }
          },
          {
            "name": "videoId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{11}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned jobs; meta.page, limit, total. Client restores latest10 plus active jobs after reload.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/VideoRecipeJob"
                      }
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          }
        }
      }
    },
    "/api/v1/video-recipe-summary-jobs/{jobId}": {
      "get": {
        "summary": "Read owned video job",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current stage/status and summaryId.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/VideoRecipeJob"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Record absent or owned by another member."
          }
        }
      }
    },
    "/api/v1/video-recipe-summary-jobs/{jobId}/retries": {
      "post": {
        "summary": "Retry owned failed video job",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already completed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/VideoRecipeJob"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Requeued or already active.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/VideoRecipeJob"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Record absent or owned by another member."
          },
          "409": {
            "description": "Another job is already active for this account."
          }
        }
      }
    },
    "/api/v1/video-recipe-summaries/{summaryId}": {
      "get": {
        "summary": "Read persisted owned video recipe",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "summaryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recipe extracted from persisted transcript; no provider call.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/VideoRecipeSummary"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Record absent or owned by another member."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ChatRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "history": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                }
              },
              "required": [
                "role",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "dietaryType": {
            "type": "string",
            "enum": [
              "vegan",
              "lacto",
              "ovo",
              "lacto_ovo"
            ]
          },
          "menuContext": {
            "type": "string",
            "maxLength": 8000
          }
        },
        "required": [
          "message",
          "history"
        ],
        "additionalProperties": false
      },
      "MealPlanRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "heightCm": {
            "type": "number",
            "exclusiveMinimum": 50,
            "exclusiveMaximum": 260
          },
          "weightKg": {
            "type": "number",
            "exclusiveMinimum": 20,
            "exclusiveMaximum": 300
          },
          "bmi": {
            "type": "number",
            "exclusiveMinimum": 8,
            "exclusiveMaximum": 100
          },
          "age": {
            "type": "integer",
            "minimum": 10,
            "maximum": 120
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "other",
              "unspecified"
            ]
          },
          "goal": {
            "type": "string",
            "enum": [
              "weight_loss",
              "muscle_gain",
              "maintenance"
            ]
          },
          "activityLevel": {
            "type": "string",
            "enum": [
              "sedentary",
              "light",
              "moderate",
              "active",
              "very_active"
            ]
          },
          "dietaryType": {
            "type": "string",
            "enum": [
              "vegan",
              "lacto",
              "ovo",
              "lacto_ovo"
            ]
          },
          "allergies": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "availableIngredients": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "required": [
          "heightCm",
          "weightKg"
        ],
        "additionalProperties": false
      },
      "FoodScanRequest": {
        "type": "object",
        "properties": {
          "imageBase64": {
            "type": "string",
            "minLength": 1,
            "maxLength": 13981016,
            "description": "Canonical base64, length multiple of4; decoded <=10485760 bytes (10 MiB). No data URL prefix.",
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp"
            ],
            "default": "image/jpeg"
          },
          "dietTypeId": {
            "type": "integer",
            "minimum": 1,
            "description": "ID chế độ ăn chay"
          },
          "scanType": {
            "type": "string",
            "enum": [
              "AUTO",
              "LABEL",
              "DISH"
            ],
            "default": "AUTO"
          },
          "dishName": {
            "type": "string",
            "maxLength": 150,
            "default": ""
          },
          "allergies": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "maxItems": 50,
            "default": []
          }
        },
        "required": [
          "imageBase64",
          "dietTypeId"
        ],
        "additionalProperties": false
      },
      "FoodScanResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "dishName": {
                "type": "string",
                "minLength": 1
              },
              "detectedScanType": {
                "type": "string",
                "enum": [
                  "LABEL",
                  "DISH"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "clear",
                  "warning"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ingredient": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "layer": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    },
                    "severity": {
                      "type": "string",
                      "enum": [
                        "violation",
                        "warning",
                        "info"
                      ]
                    }
                  },
                  "required": [
                    "ingredient",
                    "reason",
                    "layer",
                    "severity"
                  ],
                  "additionalProperties": false
                }
              },
              "identifiedIngredients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "restaurantChecklist": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
