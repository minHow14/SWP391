# D:/SWP391/SWP391/server/.env.test.example
# Mẫu biến môi trường cho bộ test, trỏ tới DB test riêng để không ảnh hưởng dữ liệu phát triển.
NODE_ENV=test
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/vegetarian_db_test
JWT_SECRET=
INTERNAL_API_KEY=
GUEST_DAILY_LIMIT=3
AI_TIMEOUT_MS=1000
CONTENT_MODERATION_ENABLED=false
# Các bộ test khôi phục mật khẩu chỉ thay thế SMTP bên trong test. Giữ việc gửi thật bị tắt trong môi trường test dùng chung.
SMTP_HOST=
# Đặt PSQL_PATH là đường dẫn tuyệt đối tới psql nếu nó không có trong PATH.
PSQL_PATH=psql
