# d:\Projects\FPT\SWP391\server\.env.example
# Cấu hình môi trường ChayXanh Backend API Server

# 1. Cổng và môi trường chạy
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 2. Cơ sở dữ liệu PostgreSQL (Yêu cầu PostgreSQL >= 15.0)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/vegetarian_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=vegetarian_db

# 3. Bảo mật JWT Authentication & Cookie
# JWT_SECRET bắt buộc tối thiểu 32 ký tự trên môi trường production
JWT_SECRET=swp391_jwt_secret_key_super_secure_vegetarian_2026
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=swp391_refresh_secret_key_super_secure_vegetarian_2026
REFRESH_TOKEN_EXPIRES_IN=30d
AI_GUEST_COOKIE_SECRET=replace_with_64_char_hex_secret_for_guest_cookies

# 4. Giao tiếp nội bộ với AI Microservice (FastAPI Port 8000)
AI_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=chayxanh_internal_secure_key_2026
AI_TIMEOUT_MS=180000

# 5. Hạn ngạch & Rate Limiting
GUEST_DAILY_LIMIT=3
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=15
PLACES_RATE_LIMIT=60

# 6. Tích hợp bản đồ & địa điểm ZIOMAP
ZIOMAP_API_KEY=
ZIOMAP_API_URL=https://ziomap-api.socibi.com/api/place/text-search
