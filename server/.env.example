# D:/SWP391/SWP391/server/.env.example
# Mẫu biến môi trường cho Back-end khi chạy local; sao chép thành .env rồi điền giá trị thật.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/vegetarian_db
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Khoá ký riêng cho refresh token (tuỳ chọn); để trống thì giữ cách dẫn xuất khoá hiện có.
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=30d
AI_SERVICE_URL=http://127.0.0.1:8000
# Các lần kiểm tra kết nối từ trang quản trị có ngân sách cố định 3000 ms; AI_TIMEOUT_MS bên dưới dành cho suy luận.
# Cùng khoá với AI Service: 32-256 ký tự ASCII in được, không có khoảng trắng; không tự động cắt khoảng trắng.
INTERNAL_API_KEY=
GUEST_DAILY_LIMIT=3
# Ngân sách gateway tính bằng ms; client quét món ăn hiện chờ 190000 ms. Giữ các ngân sách này đồng bộ.
AI_TIMEOUT_MS=180000
# Chỉ bật sau khi đã cấu hình AI; npm start/dev tự khởi động worker kiểm duyệt.
# Lệnh worker:content-moderation chạy độc lập là tuỳ chọn. Khởi động lại API/worker đang chạy sau khi thay đổi.
CONTENT_MODERATION_ENABLED=false
# Số mili giây cho mỗi lượt gọi AI (văn bản và từng ảnh tải lên chạy song song); đặt lớn hơn CONTENT_MODERATION_TIMEOUT_SECONDS của AI.
CONTENT_MODERATION_TIMEOUT_MS=30000
# Tổng số lần thử, tính cả lần gửi đầu tiên; lỗi không bao giờ tự động công khai nội dung.
CONTENT_MODERATION_MAX_ATTEMPTS=3
# ZIOMAP: tìm kiếm/chi tiết địa điểm và phân giải ảnh; chỉ gửi trong header x-api-key, không bao giờ lộ ra client.
# Thiếu khoá/ảnh thì để trống ảnh; không dùng ảnh mặc định thay thế. Ảnh đã tải lên local không cần khoá.
ZIOMAP_API_KEY=

# Worker video khởi động cùng npm start/dev; lệnh worker:video-recipes chạy độc lập là tuỳ chọn.
# Chỉ lấy metadata, không tải audio; dùng file thực thi trong ai_service/venv nếu không có trong PATH.
YT_DLP_PATH=yt-dlp
VIDEO_METADATA_TIMEOUT_MS=30000
VIDEO_AI_TIMEOUT_MS=600000
VIDEO_JOB_LEASE_MS=90000
VIDEO_JOB_POLL_MS=2000
VIDEO_JOB_RETRY_MS=30000
VIDEO_JOB_MAX_ATTEMPTS=3

# Khôi phục mật khẩu cần nhà cung cấp SMTP thật. Cấu hình trống/không hợp lệ sẽ trả về lỗi 503 thống nhất.
# Dùng cổng 465 + secure=true cho TLS ngầm định, hoặc cổng 587 + secure=false cho STARTTLS bắt buộc.
# SMTP_FROM phải là email người gửi được ủy quyền. Không dùng transport thử nghiệm hay giả lập việc gửi.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Liên kết đặt lại dùng CLIENT_URL ở trên; bắt buộc HTTPS trừ khi phát triển trên loopback local.
# Khoảng cho phép 5..60 phút; thay đổi chỉ ảnh hưởng tới các liên kết cấp mới.
PASSWORD_RESET_TTL_MINUTES=15
