# D:/SWP391/SWP391/server/.env.example
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/vegetarian_db
JWT_SECRET=
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://127.0.0.1:8000
# Same key as AI: 32-256 printable ASCII characters, no whitespace; no automatic trimming.
INTERNAL_API_KEY=
GUEST_DAILY_LIMIT=3
# Gateway budget in ms; scanner client currently waits 190000 ms. Keep these budgets aligned.
AI_TIMEOUT_MS=180000
# Opt in after configuring AI and starting npm run worker:content-moderation; restart API and worker after changes.
CONTENT_MODERATION_ENABLED=false
# Milliseconds; keep above AI CONTENT_MODERATION_TIMEOUT_SECONDS (seconds).
CONTENT_MODERATION_TIMEOUT_MS=30000
# Total attempts including the initial request; errors never automatically publish content.
CONTENT_MODERATION_MAX_ATTEMPTS=3
# Khóa API ZIOMAP cho dịch vụ bản đồ và tìm kiếm quán chay thực tế (Tùy chọn)
ZIOMAP_API_KEY=

# Video worker starts with npm start/dev; standalone worker:video-recipes is optional.
# Local metadata CLI; use an absolute executable path if it is not on PATH.
YT_DLP_PATH=yt-dlp
VIDEO_METADATA_TIMEOUT_MS=30000
VIDEO_AI_TIMEOUT_MS=600000
VIDEO_JOB_LEASE_MS=90000
VIDEO_JOB_POLL_MS=2000
VIDEO_JOB_RETRY_MS=30000
VIDEO_JOB_MAX_ATTEMPTS=3
