// D:/SWP391/SWP391/server/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id          Int             @id @default(autoincrement())
  email            String          @unique @db.VarChar(255)
  password_hash    String          @db.VarChar(255)
  full_name        String          @db.VarChar(255)
  role             Int             @default(2) @db.SmallInt
  status           String          @default("ACTIVE") @db.VarChar(20)
  deleted_at       DateTime?       @db.Timestamptz(6)
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  comments         Comment[]
  contentModerationJobs ContentModerationJob[]
  food_diaries     FoodDiary[]
  health_histories HealthHistory[]
  health_profile   HealthProfile?
  meal_plans       MealPlan[]
  notifications    Notification[]
  votes            PostVote[]
  posts            Post[]
  reports          Report[]
  allergies        UserAllergy[]
  restaurant_reviews RestaurantReview[]
  preferences ProfilePreference?
  aiGenerations AiGeneration[]
  videoRecipeSummaryJobs VideoRecipeSummaryJob[]
  videoRecipeSummaries VideoRecipeSummary[]

  @@index([email], map: "idx_users_email")
  @@index([status, deleted_at], map: "idx_users_deleted_at")
  @@map("users")
}

enum VideoRecipeSummaryJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum VideoRecipeSummaryJobStage {
  VALIDATING_VIDEO
  FETCHING_AUDIO
  TRANSCRIBING
  SUMMARIZING
  SAVING_RESULT
}

model VideoRecipeSummaryJob {
  id             String                     @id @default(uuid()) @db.Uuid
  userId         Int                        @map("user_id")
  activeUserId   Int?                       @unique(map: "uq_video_recipe_jobs_active_user") @map("active_user_id")
  videoId        String                     @map("video_id") @db.VarChar(11)
  videoUrl       String                     @map("video_url") @db.VarChar(255)
  pipelineVersion String                    @map("pipeline_version") @db.VarChar(20)
  status         VideoRecipeSummaryJobStatus @default(PENDING)
  stage          VideoRecipeSummaryJobStage  @default(VALIDATING_VIDEO)
  attempt        Int                        @default(0)
  availableAt    DateTime                   @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseToken     String?                    @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime?                  @map("lease_expires_at") @db.Timestamptz(6)
  metadata       Json?
  transcript     Json?
  errorCode      String?                    @map("error_code") @db.VarChar(100)
  errorMessage   String?                    @map("error_message") @db.VarChar(500)
  completedAt    DateTime?                  @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User                       @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  summary        VideoRecipeSummary?

  @@unique([userId, videoId, pipelineVersion], map: "uq_video_recipe_jobs_user_source_version")
  @@index([status, availableAt, createdAt, id], map: "idx_video_recipe_jobs_queue")
  @@index([status, leaseExpiresAt], map: "idx_video_recipe_jobs_expired_lease")
  @@index([userId, createdAt, id], map: "idx_video_recipe_jobs_user_created")
  @@map("video_recipe_summary_jobs")
}

model VideoRecipeSummary {
  id        String                @id @default(uuid()) @db.Uuid
  jobId     String                @unique(map: "uq_video_recipe_summaries_job") @map("job_id") @db.Uuid
  userId    Int                   @map("user_id")
  videoId   String                @map("video_id") @db.VarChar(11)
  videoUrl  String                @map("video_url") @db.VarChar(255)
  recipe    Json
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  job       VideoRecipeSummaryJob @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User                  @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt, id], map: "idx_video_recipe_summaries_user_created")
  @@map("video_recipe_summaries")
}

enum AiGenerationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum AiGenerationType {
  CHAT
  MEAL_PLAN
  FOOD_SCAN
}

model AiGeneration {
  id              String             @id @default(uuid()) @db.Uuid
  userId          Int                @map("user_id")
  type            AiGenerationType
  status          AiGenerationStatus @default(PROCESSING)
  modelName       String             @map("model_name") @db.VarChar(100)
  requestPayload  Json               @map("request_payload")
  promptMessages  Json               @map("prompt_messages")
  responsePayload Json?              @map("response_payload")
  errorCode       String?            @map("error_code") @db.VarChar(100)
  errorMessage    String?            @map("error_message")
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User               @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt, id], map: "idx_ai_generations_user_created_at")
  @@index([userId, type, status, createdAt, id], map: "idx_ai_generations_user_type_status_created_at")
  @@map("ai_generations")
}

model DietType {
  diet_type_id    Int             @id @default(autoincrement()) @db.SmallInt
  name            String          @unique @db.VarChar(100)
  description     String?
  health_profiles HealthProfile[]
  recipes         Recipe[]
  restaurants     Restaurant[]

  @@map("diet_types")
}

model HealthProfile {
  profile_id   Int       @id @default(autoincrement())
  user_id      Int       @unique
  diet_type_id Int?      @db.SmallInt
  height       Float?    @db.Real
  weight       Float?    @db.Real
  dob          DateTime? @db.Date
  gender       String?   @db.VarChar(20)
  health_goal  String?   @db.VarChar(255)
  diet_type    DietType? @relation(fields: [diet_type_id], references: [diet_type_id], onUpdate: NoAction)
  user         User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("health_profiles")
}

model HealthHistory {
  history_id    Int       @id @default(autoincrement())
  user_id       Int
  recorded_date DateTime? @default(now()) @db.Timestamptz(6)
  weight        Float     @db.Real
  bmi           Float?    @db.Real
  user          User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("health_histories")
}

model UserAllergy {
  user_id       Int
  ingredient_id Int
  ingredient    Ingredient @relation(fields: [ingredient_id], references: [ingredient_id], onDelete: Cascade, onUpdate: NoAction)
  user          User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, ingredient_id])
  @@index([ingredient_id], map: "idx_user_allergies_ingredient")
  @@map("user_allergies")
}

model Category {
  category_id     Int            @id @default(autoincrement())
  name            String         @unique @db.VarChar(100)
  post_categories PostCategory[]
  recipes         Recipe[]

  @@map("categories")
}

model Post {
  post_id         Int            @id @default(autoincrement())
  author_id       Int
  post_type       String         @db.VarChar(20)
  status          String         @default("PUBLISHED") @db.VarChar(30)
  moderationVersion Int          @default(0) @map("moderation_version")
  contentModerationJobs ContentModerationJob[]
  deleted_at      DateTime?      @db.Timestamptz(6)
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  blog            Blog?
  comments        Comment[]
  post_categories PostCategory[]
  post_votes      PostVote[]
  author          User           @relation(fields: [author_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  recipe          Recipe[]
  reports         Report[]
  video           Video?
  attachments     PostAttachment[]

  @@index([author_id], map: "idx_posts_author")
  @@index([status], map: "idx_posts_status")
  @@index([status, deleted_at], map: "idx_posts_deleted_at")
  @@map("posts")
}

model Video {
  post_id           Int     @id
  title             String  @db.VarChar(255)
  video_url         String  @db.VarChar(500)
  thumbnail_url     String? @db.VarChar(500)
  duration          Int?    @default(0)
  transcript        String?
  attached_in_blogs Blog[]
  post              Post    @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("videos")
}

model Blog {
  post_id           Int    @id
  title             String @db.VarChar(255)
  content           String
  attached_video_id Int?
  attached_video    Video? @relation(fields: [attached_video_id], references: [post_id], onDelete: SetNull, onUpdate: NoAction)
  post              Post   @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("blogs")
}

model PostCategory {
  post_id     Int
  category_id Int
  category    Category @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: NoAction)
  post        Post     @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, category_id])
  @@index([category_id], map: "idx_post_categories_category")
  @@map("post_categories")
}

model PostAttachment {
  attachment_id Int       @id @default(autoincrement())
  post_id       Int
  file_url      String    @db.VarChar(500)
  file_type     String    @db.VarChar(20)
  file_name     String?   @db.VarChar(255)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  post          Post      @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([post_id], map: "idx_post_attachments_post")
  @@map("post_attachments")
}

model Comment {
  comment_id       Int       @id @default(autoincrement())
  post_id          Int
  user_id          Int
  content          String
  is_flagged_by_ai Boolean?  @default(false)
  status           String    @default("ACTIVE") @db.VarChar(30)
  moderationVersion Int      @default(0) @map("moderation_version")
  contentModerationJobs ContentModerationJob[]
  deleted_at       DateTime? @db.Timestamptz(6)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  post             Post      @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction)
  user             User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  reports          Report[]

  @@index([post_id], map: "idx_comments_post")
  @@index([user_id], map: "idx_comments_user")
  @@index([status, deleted_at], map: "idx_comments_deleted_at")
  @@map("comments")
}

model PostVote {
  user_id   Int
  post_id   Int
  vote_type String @db.VarChar(20)
  post      Post   @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction)
  user      User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, post_id])
  @@map("post_votes")
}

enum IngredientLookupJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model IngredientLookupJob {
  id                String                    @id @default(uuid()) @db.Uuid
  ownerKey          String                    @map("owner_key") @db.Char(64)
  activeKey         String?                   @unique(map: "uq_ingredient_lookup_jobs_active") @map("active_key") @db.Char(64)
  ingredientName    String                    @map("ingredient_name") @db.VarChar(150)
  status            IngredientLookupJobStatus @default(PENDING)
  ingredientId      Int?                      @map("ingredient_id")
  sourcePhoto       Bytes?                    @map("source_photo")
  sourceMimeType    String?                   @map("source_mime_type") @db.VarChar(50)
  reservation       Json?
  leaseToken        String?                   @map("lease_token") @db.Uuid
  leaseExpiresAt    DateTime?                 @map("lease_expires_at") @db.Timestamptz(6)
  errorCode         String?                   @map("error_code") @db.VarChar(100)
  errorMessage      String?                   @map("error_message") @db.VarChar(500)
  completedAt       DateTime?                 @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  ingredient        Ingredient?               @relation(fields: [ingredientId], references: [ingredient_id], onDelete: SetNull, onUpdate: Cascade)

  @@index([ownerKey, createdAt, id], map: "idx_ingredient_lookup_jobs_owner")
  @@index([status, createdAt, id], map: "idx_ingredient_lookup_jobs_queue")
  @@index([status, leaseExpiresAt], map: "idx_ingredient_lookup_jobs_expired")
  @@index([ingredientId], map: "idx_ingredient_lookup_jobs_ingredient")
  @@map("ingredient_lookup_jobs")
}

model Ingredient {
  lookupJobs IngredientLookupJob[]
  details IngredientDetails?
  image IngredientImage?
  ingredient_id      Int                @id @default(autoincrement())
  name               String             @unique @db.VarChar(150)
  calories_per_100g  Float?             @default(0) @db.Real
  protein            Float?             @default(0) @db.Real
  fat                Float?             @default(0) @db.Real
  carbs              Float?             @default(0) @db.Real
  recipe_ingredients RecipeIngredient[]
  allergies          UserAllergy[]

  @@map("ingredients")
}

model Recipe {
  recipe_id          Int                @id @default(autoincrement())
  post_id            Int?
  category_id        Int?
  diet_type_id       Int?               @db.SmallInt
  recipe_name        String             @db.VarChar(255)
  description        String?
  image_url          String?            @db.VarChar(500)
  prep_time          Int?               @default(0)
  total_calories     Float?             @default(0) @db.Real
  instructions       String?
  food_diaries       FoodDiary[]
  meal_plan_details  MealPlanDetail[]
  recipe_ingredients RecipeIngredient[]
  categories         Category?          @relation(fields: [category_id], references: [category_id], onUpdate: NoAction)
  diet_type          DietType?          @relation(fields: [diet_type_id], references: [diet_type_id], onUpdate: NoAction)
  post               Post?              @relation(fields: [post_id], references: [post_id], onDelete: SetNull, onUpdate: NoAction)
  restaurant_recipes RestaurantRecipe[]

  @@index([post_id], map: "idx_recipes_post")
  @@index([category_id], map: "idx_recipes_category")
  @@index([diet_type_id], map: "idx_recipes_diet_type")
  @@map("recipes")
}

model RecipeIngredient {
  recipe_id     Int
  ingredient_id Int
  quantity      Float      @db.Real
  unit          String     @db.VarChar(50)
  ingredient    Ingredient @relation(fields: [ingredient_id], references: [ingredient_id], onDelete: Cascade, onUpdate: NoAction)
  recipe        Recipe     @relation(fields: [recipe_id], references: [recipe_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([recipe_id, ingredient_id])
  @@index([ingredient_id], map: "idx_recipe_ingredients_ingredient")
  @@map("recipe_ingredients")
}

model MealPlan {
  plan_id         Int              @id @default(autoincrement())
  user_id         Int
  title           String           @default("Thực đơn tuần") @db.VarChar(255)
  start_date      DateTime         @db.Date
  end_date        DateTime         @db.Date
  target_calories Float?           @db.Real
  details         MealPlanDetail[]
  user            User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, start_date], map: "idx_meal_plans_user_start_date")
  @@map("meal_plans")
}

model MealPlanDetail {
  plan_detail_id Int      @id @default(autoincrement())
  plan_id        Int
  recipe_id      Int?
  meal_type      String   @db.VarChar(30)
  day_of_week    Int      @db.SmallInt
  custom_food_name String? @db.VarChar(255)
  calories       Float?   @db.Real
  protein        Float?   @db.Real
  carbs          Float?   @db.Real
  fat            Float?   @db.Real
  meal_plan      MealPlan @relation(fields: [plan_id], references: [plan_id], onDelete: Cascade, onUpdate: NoAction)
  recipe         Recipe?  @relation(fields: [recipe_id], references: [recipe_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([plan_id], map: "idx_meal_plan_details_plan")
  @@map("meal_plan_details")
}

model FoodDiary {
  nutrients DiaryNutrients?
  diary_id         Int       @id @default(autoincrement())
  user_id          Int
  consumed_date    DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  meal_type        String    @db.VarChar(30)
  recipe_id        Int?
  custom_food_name String?   @db.VarChar(255)
  calories         Float?    @default(0) @db.Real
  recipe           Recipe?   @relation(fields: [recipe_id], references: [recipe_id], onUpdate: NoAction)
  user             User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, consumed_date], map: "idx_food_diaries_user_date")
  @@map("food_diaries")
}

model Restaurant {
  details RestaurantDetails?
  reviews RestaurantReview[]
  restaurant_id      Int                @id @default(autoincrement())
  name               String             @db.VarChar(255)
  address            String             @db.VarChar(255)
  phone              String?            @db.VarChar(50)
  image_url          String?            @db.VarChar(500)
  rating             Float?             @default(4.5) @db.Real
  latitude           Decimal?           @db.Decimal(10, 7)
  longitude          Decimal?           @db.Decimal(10, 7)
  diet_type_id       Int?               @db.SmallInt
  source             String             @default("local") @db.VarChar(20)
  status             String             @default("APPROVED") @db.VarChar(20)
  place_id           String?            @unique(map: "uq_restaurants_place_id") @db.VarChar(100)
  created_at         DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?          @updatedAt @db.Timestamptz(6)
  restaurant_recipes RestaurantRecipe[]
  diet_type          DietType?          @relation(fields: [diet_type_id], references: [diet_type_id], onUpdate: NoAction)

  @@index([latitude, longitude], map: "idx_restaurants_coordinates")
  @@index([diet_type_id], map: "idx_restaurants_diet_type")
  @@index([status, latitude, longitude], map: "idx_restaurants_status_coords")
  @@index([diet_type_id, latitude, longitude], map: "idx_restaurants_diet_coords")
  @@map("restaurants")
}

model RestaurantRecipe {
  price RestaurantMenuPrice?
  restaurant_id Int
  recipe_id     Int
  recipe        Recipe     @relation(fields: [recipe_id], references: [recipe_id], onDelete: Cascade, onUpdate: NoAction)
  restaurant    Restaurant @relation(fields: [restaurant_id], references: [restaurant_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([restaurant_id, recipe_id])
  @@map("restaurant_recipes")
}

enum ContentModerationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ContentModerationJob {
  id             String                     @id @default(uuid()) @db.Uuid
  userId         Int                        @map("user_id")
  postId         Int?                       @map("post_id")
  commentId      Int?                       @map("comment_id")
  contentVersion Int                        @map("content_version")
  title          String?                    @db.VarChar(255)
  content        String
  status         ContentModerationJobStatus  @default(PENDING)
  attempt        Int                        @default(0)
  availableAt    DateTime                   @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseToken     String?                    @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime?                  @map("lease_expires_at") @db.Timestamptz(6)
  result         Json?
  applied        Boolean                    @default(false)
  errorCode      String?                    @map("error_code") @db.VarChar(100)
  errorMessage   String?                    @map("error_message") @db.VarChar(500)
  completedAt    DateTime?                   @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User                       @relation(fields: [userId], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  post           Post?                      @relation(fields: [postId], references: [post_id], onDelete: Cascade, onUpdate: NoAction)
  comment        Comment?                   @relation(fields: [commentId], references: [comment_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([postId, contentVersion], map: "uq_content_moderation_jobs_post_version")
  @@unique([commentId, contentVersion], map: "uq_content_moderation_jobs_comment_version")
  @@index([userId], map: "idx_content_moderation_jobs_user")
  @@index([postId], map: "idx_content_moderation_jobs_post")
  @@index([commentId], map: "idx_content_moderation_jobs_comment")
  @@index([status, availableAt, createdAt, id], map: "idx_content_moderation_jobs_queue")
  @@index([status, leaseExpiresAt], map: "idx_content_moderation_jobs_lease")
  @@map("content_moderation_jobs")
}

model Report {
  report_id   Int       @id @default(autoincrement())
  reporter_id Int
  post_id     Int?
  comment_id  Int?
  reason      String
  status      String    @default("PENDING") @db.VarChar(30)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  comment     Comment?  @relation(fields: [comment_id], references: [comment_id], onDelete: Cascade, onUpdate: NoAction)
  post        Post?     @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: NoAction)
  reporter    User      @relation(fields: [reporter_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([reporter_id], map: "idx_reports_reporter")
  @@index([post_id], map: "idx_reports_post")
  @@index([comment_id], map: "idx_reports_comment")
  @@index([status], map: "idx_reports_status")
  @@map("reports")
}

model Notification {
  notification_id Int       @id @default(autoincrement())
  user_id         Int
  content         String    @db.VarChar(500)
  is_read         Boolean?  @default(false)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  user            User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notifications")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiLog {
  logId          Int       @id @default(autoincrement()) @map("log_id")
  modelName      String    @map("model_name") @db.VarChar(100)
  action         String    @db.VarChar(100)
  status         String    @db.VarChar(20)
  errorFeedback  String?   @map("error_feedback")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ai_logs")
}

model IngredientDetails {
  ingredient_id Int @id
  category String @db.VarChar(30)
  origin String
  plant Boolean?
  description String
  cooking String
  aliases String @default("")
  image_url String?
  ingredient Ingredient @relation(fields:[ingredient_id],references:[ingredient_id],onDelete:Cascade,onUpdate:NoAction)
  @@map("ingredient_details")
}
model IngredientImage {
  ingredient_id Int @id
  mime_type String @db.VarChar(50)
  image_data Bytes
  attribution String?
  source_url String?
  license String?
  license_text String?
  ingredient Ingredient @relation(fields:[ingredient_id],references:[ingredient_id],onDelete:Cascade,onUpdate:NoAction)
  @@map("ingredient_images")
}
model IngredientAlternative {
  id String @id @db.VarChar(40)
  chip String
  emoji String
  original String
  role String
  alternatives Json @db.JsonB
  description String
  keywords String
  @@map("ingredient_alternatives")
}
model RestaurantDetails {
  restaurant_id Int @id
  city String
  hours String?
  price_range String?
  separate_kitchen Boolean?
  restaurant Restaurant @relation(fields:[restaurant_id],references:[restaurant_id],onDelete:Cascade,onUpdate:NoAction)
  @@map("restaurant_details")
}
model RestaurantReview {
  review_id Int @id @default(autoincrement())
  restaurant_id Int
  user_id Int
  stars Int @db.SmallInt
  content String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  restaurant Restaurant @relation(fields:[restaurant_id],references:[restaurant_id],onDelete:Cascade,onUpdate:NoAction)
  user User @relation(fields:[user_id],references:[user_id],onDelete:Cascade,onUpdate:NoAction)
  @@index([restaurant_id],map:"restaurant_reviews_place_idx")
  @@index([user_id], map: "idx_restaurant_reviews_user")
  @@map("restaurant_reviews")
}
model DiaryNutrients {
  diary_id Int @id
  serving String @default("1 phần")
  protein Float @default(0) @db.Real
  carbs Float @default(0) @db.Real
  fat Float @default(0) @db.Real
  fiber Float @default(0) @db.Real
  diary FoodDiary @relation(fields:[diary_id],references:[diary_id],onDelete:Cascade,onUpdate:NoAction)
  @@map("diary_nutrients")
}
model ProfilePreference {
  user_id Int @id
  calorie_goal Float? @db.Real
  goal String?
  protein_goal Float? @default(70) @db.Real
  carbs_goal Float? @default(230) @db.Real
  fat_goal Float? @default(45) @db.Real
  fiber_goal Float? @default(30) @db.Real
  user User @relation(fields:[user_id],references:[user_id],onDelete:Cascade,onUpdate:NoAction)
  @@map("profile_preferences")
}
model RestaurantMenuPrice {
  restaurant_id Int
  recipe_id Int
  price Decimal? @db.Decimal(18, 2)
  menu RestaurantRecipe @relation(fields:[restaurant_id,recipe_id],references:[restaurant_id,recipe_id],onDelete:Cascade,onUpdate:NoAction)
  @@id([restaurant_id,recipe_id])
  @@map("restaurant_menu_prices")
}

/// BE quản lý hạn mức dùng chung cho chatbot và tạo thực đơn.
/// guest_id là X-Guest-Id hoặc ip:<địa chỉ>; quota_date tính theo giờ Việt Nam (+07:00).
model GuestQuota {
  guestId             String   @map("guest_id") @db.VarChar(100)
  quotaDate           DateTime @map("quota_date") @db.Date
  usedCount           Int      @default(0) @map("used_count")
  reservationRevision Int      @default(0) @map("reservation_revision")
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  @@id([guestId, quotaDate])
  @@map("guest_quota")
}
