    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "fuse.js": "^7.5.0",
    "geolib": "^4.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.3",
    "multer": "^2.4.0",
    "pino": "10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
